# Installed to /etc/monitoring/central/grafana.env by scripts/install-central.sh
# Grafana reads GF_* variables from the environment (see systemd unit).
# Set all values before production; do not commit the installed file.

# Grafana’s default login name is usually "admin".
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=
# Public URL users type in the browser (use your central host IP or DNS, not 0.0.0.0).
GF_SERVER_ROOT_URL=
GF_INSTALL_PLUGINS=
