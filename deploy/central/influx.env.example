# InfluxDB bootstrap (used by install-central.sh). A API token is written to
# /etc/monitoring/central/influx-token on first setup (do not commit that file).

# Optional: document the public URL for the HTTP API (your central IP or DNS).
INFLUX_URL=
INFLUX_ORG=monitoring
INFLUX_BUCKET=network
INFLUX_RETENTION=720h
# Required for first-time setup; choose a strong secret before running install-central.sh.
INFLUX_ADMIN_PASSWORD=
